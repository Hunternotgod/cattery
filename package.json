{
  "name": "cattery",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "repos:sync": "node scripts/sync-gitee-repos.mjs",
    "release:sync": "node scripts/sync-miao-release.mjs",
    "content:sync": "npm run repos:sync && npm run release:sync && npm run contributions:sync",
    "contributions:sync": "node scripts/sync-gitee-contributions.mjs",
    "studio": "node studio/server.mjs",
    "deploy": "npm run build && npx --yes edgeone@1.6.44 makers deploy dist --name cattery-live --env production --area overseas"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "astro": "^5.18.2",
    "gsap": "^3.15.0",
    "pagefind": "^1.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/three": "^0.186.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@astrojs/language-server": "2.15.4"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "description": "肥猫叉烧的个人作品集：赛博电竞房、项目、代码仓库和笔记。"
}
