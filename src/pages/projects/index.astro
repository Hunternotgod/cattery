---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Portrait from '../../components/Portrait.astro';
import { SITE } from '../../data/site';
import { REPO_SNAPSHOT, formatRepoDate } from '../../data/repos';
import { PROJECT_STATUS_META } from '../../data/projects';
import ContributionHeatmap from '../../components/ContributionHeatmap.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const synced = REPO_SNAPSHOT.syncedAt ? formatRepoDate(REPO_SNAPSHOT.syncedAt) : null;
---
<BaseLayout title="项目" description="肥猫叉烧的项目与代码仓库：喵秘书、运维、桌面应用和实验项目。">
  <div class="container">
    <header class="page-head page-head-projects">
      <h1 class="page-title">项目</h1>
      <p class="page-description">
        做过的软件、正在维护的仓库，以及一些还在房间角落里发酵的想法。
      </p>
    </header>

    <section class="project-feature-list">
      {projects.map((project) => (
        <article class="project-feature">
          {project.data.cover && (
            <a class="project-cover" href={`/projects/${project.id}/`} aria-label={`查看 ${project.data.title}`}>
              <img src={project.data.cover} alt={`${project.data.title} 界面`} loading="lazy" />
            </a>
          )}
          <div class="project-feature-body">
            <p class="section-kicker">featured project</p>
            <div class="project-title-row">
              <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
              <span class:list={['project-status', `status-${project.data.status}`]} title={PROJECT_STATUS_META[project.data.status].description}>{PROJECT_STATUS_META[project.data.status].label}</span>
            </div>
            <p class="project-subtitle">{project.data.subtitle}</p>
            <p>{project.data.summary}</p>
            <div class="stack-row">
              {project.data.stack.slice(0, 6).map((item) => <span>{item}</span>)}
            </div>
            <div class="project-actions">
              <a class="button button-primary" href={`/projects/${project.id}/`}>查看案例</a>
              {project.data.links.download && (
                <a class="text-link" href={project.data.links.download} target="_blank" rel="noopener noreferrer">下载 Windows 版</a>
              )}
            </div>
          </div>
          <Portrait kind="cat" class="project-feature-mascot" />
        </article>
      ))}
    </section>

    <section class="repo-section">
      <div class="section-head">
        <div>
          <p class="section-kicker">pig boss shelf</p>
          <h2 class="section-title">仓库书架</h2>
        </div>
        <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">全部仓库</a>
      </div>
      <p class="section-intro">猪老板把最近在维护的项目排成了一列。点击书脊可以直接去 Gitee。</p>
      <div class="repo-index">
        {REPO_SNAPSHOT.repos.map((repo, index) => (
          <a class="repo-index-row" href={repo.url} target="_blank" rel="noopener noreferrer">
            <span class="repo-index-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="repo-index-body">
              <strong>{repo.name}</strong>
              <small>{repo.description}</small>
            </span>
            <span class="repo-index-meta">
              <span>{repo.language ?? '代码'}</span>
              <span>{repo.stars} star</span>
            </span>
          </a>
        ))}
      </div>
      {synced && <p class="section-footnote">仓库数据更新于 {synced}</p>}
      <ContributionHeatmap variant="full" class="repo-contributions" />
    </section>
  </div>
</BaseLayout>
