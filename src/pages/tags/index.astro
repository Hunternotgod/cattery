---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts, tagHref } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---
<BaseLayout title="标签" description="按标签浏览 cattery 的文章。">
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">标签</h1>
      <p class="page-description">从感兴趣的主题开始，找到相关的文章。</p>
    </header>

    <section class="topic-index">
      <div class="topic-grid">
        {tags.map(([tag, count]) => (
          <a class="topic-item" href={tagHref(tag)}>
            <span class="topic-name">#{tag}</span>
            <span class="topic-count">{String(count).padStart(2, '0')}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
