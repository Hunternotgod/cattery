---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts, tagHref } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---
<BaseLayout title="标签" description="按标签浏览 CatBok 的文章。">
  <div class="container">
    <header class="page-header">
      <p class="page-kicker">Tags</p>
      <h1 class="page-title">标签</h1>
      <p class="page-description">从感兴趣的主题开始，找到相关的文章。</p>
    </header>

    <section class="section" style="padding-top: 0;">
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a class="tag" href={tagHref(tag)}>
            {tag}
            <span class="tag-count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
