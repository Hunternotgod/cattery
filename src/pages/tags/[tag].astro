---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts).map(([tag]) => tag);

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props as Props;
---
<BaseLayout title={`标签：${tag}`} description={`cattery 中所有带有「${tag}」标签的文章。`}>
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">#{tag}</h1>
      <p class="page-description">共 {posts.length} 篇文章。</p>
    </header>

    <section class="post-index">
      {posts.map((post) => <PostCard post={post} showTags={false} />)}
    </section>
  </div>
</BaseLayout>
