---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { SITE } from '../data/site';
---
<BaseLayout title="关于" description="关于 cattery、肥猫叉烧，以及猫工程师、猪老板和柯基捣蛋鬼。">
  <div class="container">
    <header class="page-head page-head-about">
      <h1 class="page-title">关于</h1>
      <p class="page-description">
        一个普通开发者的个人作品集。代码、项目、笔记，还有三只住在房间里的动物。
      </p>
    </header>

    <section class="about-layout">
      <div class="about-copy prose">
        <h2>我是谁</h2>
        <p>
          我是肥猫叉烧，一个喜欢写代码、也喜欢猫的人。平时折腾工具、做小项目，
          偶尔读书、拍照、散步，然后把过程中的想法整理成文字。
        </p>
        <p>
          cattery 不是公司主页，也不是简历。它更像一个开放的工作室：
          做过的软件放在工作台上，代码仓库排在书架上，没整理好的想法丢在柯基的角落。
        </p>

        <h2>这个站怎么来的</h2>
        <p>
          网站用 Astro 构建，首页是一个用 Three.js 程序化搭建的 3D 房间。
          项目数据来自 Gitee，笔记是 Markdown，站内搜索由 Pagefind 生成。
          没有数据库，也没有运行时后端。
        </p>

        <h2>联系</h2>
        <p>
          Gitee：<a href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">fat-cat-barbecue</a><br />
          邮箱：<span>{SITE.email}</span>
        </p>
      </div>

      <aside class="about-sidebar">
        <div class="about-sidebar-block">
          <p class="section-kicker">residents</p>
          <h2>房间住户</h2>
          <div class="mascot-roster">
            <div class="mascot-roster-item">
              <Mascot kind="cat" class="mascot-roster-art" />
              <div><strong>猫工程师</strong><span>项目、调试和凌晨的提交。</span></div>
            </div>
            <div class="mascot-roster-item">
              <Mascot kind="pig" class="mascot-roster-art" />
              <div><strong>猪老板</strong><span>仓库、审阅和“这个能不能上线”。</span></div>
            </div>
            <div class="mascot-roster-item">
              <Mascot kind="corgi" class="mascot-roster-art" />
              <div><strong>柯基捣蛋鬼</strong><span>笔记、意外和打翻的纸堆。</span></div>
            </div>
          </div>
        </div>

        <div class="about-sidebar-block">
          <p class="section-kicker">built with</p>
          <ul class="about-tech">
            <li>Astro</li>
            <li>Three.js + GSAP</li>
            <li>Markdown + Pagefind</li>
            <li>Gitee API snapshot</li>
            <li>EdgeOne Pages</li>
          </ul>
        </div>
      </aside>
    </section>
  </div>
</BaseLayout>
