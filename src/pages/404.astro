---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
---
<BaseLayout title="页面不存在" description="这个页面好像被柯基叼走了。">
  <div class="container not-found">
    <div class="not-found-panel">
      <Portrait kind="corgi" class="not-found-mascot" />
      <p class="not-found-code">404</p>
      <h1>柯基把这一页叼走了</h1>
      <p>你访问的页面不存在，或者已经被挪到了别处。</p>
      <a class="button button-primary" href="/">回到 cattery</a>
    </div>
  </div>
</BaseLayout>
