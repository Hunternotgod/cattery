---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import {
  formatDateDot,
  getAllTags,
  getPublishedPosts,
  postHref,
  readingTime,
  tagHref,
} from '../utils/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 5);
const lead = latest[0];
const rest = latest.slice(1);
const tags = getAllTags(posts);
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <h1 class="hero-wordmark">
        <span>{SITE.title}</span>
        <span class="wordmark-dot" aria-hidden="true"></span>
      </h1>
      <p class="hero-lede">给代码、猫和日常，留一块安静的地方。</p>
      <p class="hero-body">
        这里记录写代码时想明白的事、猫踩过键盘的瞬间，以及普通日子里值得留下的片段。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/posts/">浏览文章</a>
        <a class="text-link" href="/about/">关于这个站</a>
      </div>
    </div>

    <figure class="hero-visual">
      <svg class="eye-svg" viewBox="0 0 440 300" role="img" aria-label="一只猫的眼睛">
        <path d="M18 150C82 42 358 42 422 150C358 258 82 258 18 150Z" fill="var(--mint)" />
        <circle cx="220" cy="150" r="82" fill="var(--cobalt)" />
        <ellipse cx="220" cy="150" rx="21" ry="82" fill="var(--ink)" />
        <circle cx="197" cy="116" r="14" fill="var(--paper)" opacity="0.55" />
        <path d="M422 150c20-1 30-14 24-30" stroke="var(--cobalt)" stroke-width="3" stroke-linecap="round" fill="none" />
        <path d="M54 158 18 148M56 182 24 192M386 158 422 148M384 182 416 192" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
      </svg>
      <figcaption class="hero-figcaption">a personal archive<br />since 2026</figcaption>
    </figure>
  </section>

  {lead && (
    <div class="container hero-latest">
      <span class="hero-latest-label">最新</span>
      <a href={postHref(lead)}>{lead.data.title}</a>
      <time datetime={lead.data.pubDate.toISOString()}>{formatDateDot(lead.data.pubDate)}</time>
    </div>
  )}

  <section class="home-feature container">
    <div class="section-head">
      <h2 class="section-title">最近写下的</h2>
      <a class="text-link" href="/posts/">全部文章</a>
    </div>

    {lead ? (
      <div class="feature-grid">
        <article class="feature-post">
          <div class="feature-meta">
            <time datetime={lead.data.pubDate.toISOString()}>{formatDateDot(lead.data.pubDate)}</time>
            <span>{readingTime(lead.body ?? '')} 分钟阅读</span>
          </div>
          <h3 class="feature-title">
            <a href={postHref(lead)}>{lead.data.title}</a>
          </h3>
          <p class="feature-description">{lead.data.description}</p>
          {lead.data.tags.length > 0 && (
            <div class="tag-row">
              {lead.data.tags.map((tag) => (
                <a class="tag" href={tagHref(tag)}>{tag}</a>
              ))}
            </div>
          )}
        </article>

        <div class="feature-index">
          {rest.map((post) => (
            <a class="index-row" href={postHref(post)}>
              <time datetime={post.data.pubDate.toISOString()}>{formatDateDot(post.data.pubDate)}</time>
              <span>{post.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <p class="feature-description" style="padding-top: 24px;">还没有文章，先写下第一篇吧。</p>
    )}
  </section>

  {tags.length > 0 && (
    <section class="topic-index container">
      <div class="section-head">
        <h2 class="section-title">按主题</h2>
        <a class="text-link" href="/tags/">全部标签</a>
      </div>
      <div class="topic-grid">
        {tags.map(([tag, count]) => (
          <a class="topic-item" href={tagHref(tag)}>
            <span class="topic-name">#{tag}</span>
            <span class="topic-count">{String(count).padStart(2, '0')}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
