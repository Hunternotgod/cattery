---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { SITE } from '../data/site';
import { REPO_SNAPSHOT, formatRepoDate } from '../data/repos';
import { formatDateDot, getPublishedNotes, noteHref, readingTime } from '../utils/notes';

const projects = await getCollection('projects', ({ data }) => data.featured && !data.draft);
const project = projects.sort((a, b) => a.data.order - b.data.order)[0];
const notes = (await getPublishedNotes()).slice(0, 3);
---
<BaseLayout home>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/room-poster.webp" />
  </Fragment>
  <div class="room-experience" data-room>
    <div class="room-poster" aria-hidden="true">
      <img src="/images/room-poster.webp" alt="" width="1600" height="1000" fetchpriority="high" />
    </div>
    <canvas class="room-canvas" data-room-canvas aria-hidden="true"></canvas>
    <div class="room-veil" aria-hidden="true"></div>

    <a class="room-skip" href="#station-project">跳过 3D，直接看内容</a>

    <aside class="room-progress" aria-hidden="true">
      <span class="room-progress-track"><span class="room-progress-fill"></span></span>
      <span class="room-progress-dots"><i></i><i></i><i></i><i></i><i></i></span>
    </aside>

    <div class="room-content">
      <section class="room-station station-intro is-active" data-station="0">
        <div class="station-panel station-panel-hero">
          <p class="station-kicker">cattery / personal archive</p>
          <h1 class="station-wordmark">cattery<span class="wordmark-dot"></span></h1>
          <p class="station-lede">猫、猪和柯基一起住的<br />个人作品集。</p>
          <p class="station-copy">
            我是肥猫叉烧。这里放我认真做过的软件、写过的代码，以及一些还没有想清楚的笔记。
          </p>
          <div class="station-actions">
            <a class="button button-primary magnet" href="#station-project">走进房间</a>
            <a class="text-link" href="/projects/">直接看项目</a>
          </div>
          <p class="station-hint">向下滚动，猫工程师正在等你。</p>
        </div>
      </section>

      <section class="room-station station-project" id="station-project" data-station="1">
        <div class="station-panel station-panel-project">
          <p class="station-label">01 / 猫工程师的工作台</p>
          <div class="station-project-head">
            <div>
              <h2>{project?.data.title ?? '喵秘书'}</h2>
              <p class="station-subtitle">{project?.data.subtitle ?? '把群消息整理成一份能看的日报'}</p>
            </div>
            <Mascot kind="cat" class="station-mascot" />
          </div>
          <p>{project?.data.summary ?? '一款把 PC 微信群消息整理成结构化日报的 Windows 桌面应用。'}</p>
          {project && (
            <div class="stack-row">
              {project.data.stack.slice(0, 5).map((item) => <span>{item}</span>)}
            </div>
          )}
          <div class="station-actions">
            <a class="button button-primary" href={project ? `/projects/${project.id}/` : '/projects/'}>查看案例</a>
            {project?.data.links.download && (
              <a class="text-link" href={project.data.links.download} target="_blank" rel="noopener noreferrer">下载 Windows 版</a>
            )}
          </div>
        </div>
      </section>

      <section class="room-station station-repos" data-station="2">
        <div class="station-panel station-panel-repos">
          <p class="station-label">02 / 猪老板的书架</p>
          <div class="station-panel-head">
            <h2>代码仓库</h2>
            <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">全部仓库</a>
          </div>
          <p class="station-copy">猪老板把最近在维护的项目都放在这排书架上。</p>
          <div class="repo-list">
            {REPO_SNAPSHOT.repos.map((repo) => (
              <a class="repo-row" href={repo.url} target="_blank" rel="noopener noreferrer">
                <span class="repo-name">{repo.name}</span>
                <span class="repo-description">{repo.description}</span>
                <span class="repo-meta">{repo.language ?? '代码'} · {repo.stars} star</span>
              </a>
            ))}
          </div>
          <p class="station-footnote">
            {REPO_SNAPSHOT.syncedAt ? `数据同步于 ${formatRepoDate(REPO_SNAPSHOT.syncedAt)}` : '仓库数据等待同步'}
          </p>
        </div>
      </section>

      <section class="room-station station-notes" data-station="3">
        <div class="station-panel station-panel-notes">
          <p class="station-label">03 / 柯基的笔记角</p>
          <div class="station-panel-head">
            <h2>最近写下的</h2>
            <a class="text-link" href="/notes/">全部笔记</a>
          </div>
          <p class="station-copy">柯基把纸堆弄乱了，但重要的几页还在。</p>
          <div class="note-list">
            {notes.map((note) => (
              <a class="note-row-link" href={noteHref(note)}>
                <time datetime={note.data.pubDate.toISOString()}>{formatDateDot(note.data.pubDate)}</time>
                <span>{note.data.title}</span>
                <small>{readingTime(note.body ?? '')} 分钟</small>
              </a>
            ))}
          </div>
          <div class="station-actions">
            <Mascot kind="corgi" class="station-mascot station-mascot-small" />
            <button class="poke-button" type="button" data-poke="corgi">逗一下柯基</button>
          </div>
        </div>
      </section>

      <section class="room-station station-about" data-station="4">
        <div class="station-panel station-panel-about">
          <p class="station-label">04 / 窗边</p>
          <h2>关于肥猫叉烧</h2>
          <p>
            一个喜欢写代码、也喜欢猫的人。平时折腾工具、做小项目，偶尔读书和散步。
            这个房间里的三只动物分别负责项目、仓库和那些没整理好的想法。
          </p>
          <div class="mascot-line">
            <span><b>猫工程师</b> 负责项目和调试</span>
            <span><b>猪老板</b> 负责仓库和审阅</span>
            <span><b>柯基捣蛋鬼</b> 负责笔记和意外</span>
          </div>
          <div class="station-actions">
            <a class="button button-primary" href="/about/">关于这个站</a>
            <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">去 Gitee 看看</a>
          </div>
          <div class="poke-row">
            <button class="poke-button" type="button" data-poke="cat">摸摸猫</button>
            <button class="poke-button" type="button" data-poke="pig">拍拍猪</button>
            <button class="poke-button" type="button" data-poke="corgi">逗逗柯基</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const room = document.querySelector<HTMLElement>('[data-room]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (room && !reducedMotion) {
    const loadRoom = () => import('../scripts/room').then(({ initRoom }) => initRoom(room));
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(loadRoom, { timeout: 1200 });
    } else {
      setTimeout(loadRoom, 180);
    }
  }
</script>



