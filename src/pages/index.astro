---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { SITE } from '../data/site';
import { REPO_SNAPSHOT, formatRepoDate } from '../data/repos';
import { formatDateDot, getPublishedNotes, noteHref, readingTime } from '../utils/notes';
import ContributionHeatmap from '../components/ContributionHeatmap.astro';

const projects = await getCollection('projects', ({ data }) => data.featured && !data.draft);
const project = projects.sort((a, b) => a.data.order - b.data.order)[0];
const notes = (await getPublishedNotes()).slice(0, 3);
---
<BaseLayout home>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/room-poster.webp" />
  </Fragment>
  <div class="room-experience" data-room>
    <div class="room-poster" aria-hidden="true">
      <img class="room-poster-dark" src="/images/room-poster.webp" alt="" width="1600" height="1000" fetchpriority="high" />
      <img class="room-poster-lit" src="/images/room-poster-lit.webp" alt="" width="1600" height="1000" loading="lazy" />
    </div>
    <canvas class="room-canvas" data-room-canvas aria-hidden="true"></canvas>
    <div class="room-veil" aria-hidden="true"></div>

    <a class="room-skip" href="#station-project">跳过 3D，直接看内容</a>

    <aside class="room-progress" aria-hidden="true">
      <span class="room-progress-track"><span class="room-progress-fill"></span></span>
      <span class="room-progress-dots"><i></i><i></i><i></i><i></i><i></i></span>
    </aside>

    <div class="character-speech" data-character-speech role="status" aria-live="polite" hidden>
      <span class="character-speech-name" data-character-speech-name></span>
      <p data-character-speech-text></p>
    </div>

    <div class="room-content">
      <section class="room-station station-intro is-active" data-station="0">
        <div class="station-panel station-panel-hero" data-station-panel>
          <button class="station-panel-toggle" type="button" data-panel-toggle aria-expanded="true" aria-controls="panel-intro">
            <span class="station-panel-toggle-title">cattery / 个人作品集</span>
            <span class="station-panel-toggle-action" data-toggle-action>展开内容</span>
          </button>
          <div class="station-panel-body" id="panel-intro" data-panel-body>
            <div class="hero-panel-grid">
              <div class="hero-panel-lead">
                <p class="station-kicker">cattery / personal archive</p>
                <span class="room-mode-label" data-theme-label>NIGHT MODE</span>
                <h1 class="station-wordmark">cattery<span class="wordmark-dot"></span></h1>
                <p class="station-lede">猫、猪和柯基一起住的<br />个人作品集。</p>
              </div>
              <div class="hero-panel-copy">
                <p class="station-copy">
                  我是肥猫叉烧。这里放我认真做过的软件、写过的代码，以及一些还没有想清楚的笔记。
                </p>
                <div class="station-actions">
                  <a class="button button-primary magnet" href="#station-project">走进房间</a>
                  <a class="text-link" href="/projects/">直接看项目</a>
                </div>
                <p class="station-hint">向下滚动，猫工程师正在等你。</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="room-station station-project" id="station-project" data-station="1">
        <div class="station-panel station-panel-project" data-station-panel>
          <button class="station-panel-toggle" type="button" data-panel-toggle aria-expanded="true" aria-controls="panel-project">
            <span class="station-panel-toggle-title">01 / 猫工程师的工作台</span>
            <span class="station-panel-toggle-action" data-toggle-action>展开内容</span>
          </button>
          <div class="station-panel-body" id="panel-project" data-panel-body>
            <p class="station-label">01 / 猫工程师的工作台</p>
            <div class="station-project-head">
              <div>
                <h2>{project?.data.title ?? '喵秘书'}</h2>
                <p class="station-subtitle">{project?.data.subtitle ?? '把群消息整理成一份能看的日报'}</p>
              </div>
              <Portrait kind="cat" class="station-mascot" loading="eager" />
            </div>
            <p>{project?.data.summary ?? '一款把 PC 微信群消息整理成结构化日报的 Windows 桌面应用。'}</p>
            {project && (
              <div class="stack-row">
                {project.data.stack.slice(0, 5).map((item) => <span>{item}</span>)}
              </div>
            )}
            <div class="station-actions">
              <a class="button button-primary" href={project ? `/projects/${project.id}/` : '/projects/'}>查看案例</a>
              {project?.data.links.download && <DownloadButton class="text-link" label="下载 Windows 版" />}
            </div>
          </div>
        </div>
      </section>

      <section class="room-station station-repos" data-station="2">
        <div class="station-panel station-panel-repos" data-station-panel>
          <button class="station-panel-toggle" type="button" data-panel-toggle aria-expanded="true" aria-controls="panel-repos">
            <span class="station-panel-toggle-title">02 / 猪老板的书架</span>
            <span class="station-panel-toggle-action" data-toggle-action>展开内容</span>
          </button>
          <div class="station-panel-body" id="panel-repos" data-panel-body>
            <p class="station-label">02 / 猪老板的书架</p>
            <div class="station-panel-head station-repos-head">
              <div class="station-repos-heading">
                <h2>代码仓库</h2>
                <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">全部仓库</a>
              </div>
              <Portrait kind="pig" class="station-mascot station-repos-mascot" />
            </div>
            <p class="station-copy">猪老板把最近在维护的项目都放在这排书架上。</p>
            <div class="repo-list">
              {REPO_SNAPSHOT.repos.map((repo) => (
                <a class="repo-row" href={repo.url} target="_blank" rel="noopener noreferrer">
                  <span class="repo-name">{repo.name}</span>
                  <span class="repo-description">{repo.description}</span>
                  <span class="repo-meta">{repo.language ?? '代码'} · {repo.stars} star</span>
                </a>
              ))}
            </div>
            <p class="station-footnote">
              {REPO_SNAPSHOT.syncedAt ? `数据同步于 ${formatRepoDate(REPO_SNAPSHOT.syncedAt)}` : '仓库数据等待同步'}
            </p>
            <ContributionHeatmap variant="compact" class="station-contributions" />
          </div>
        </div>
      </section>

      <section class="room-station station-notes" data-station="3">
        <div class="station-panel station-panel-notes" data-station-panel>
          <button class="station-panel-toggle" type="button" data-panel-toggle aria-expanded="true" aria-controls="panel-notes">
            <span class="station-panel-toggle-title">03 / 柯基的笔记角</span>
            <span class="station-panel-toggle-action" data-toggle-action>展开内容</span>
          </button>
          <div class="station-panel-body" id="panel-notes" data-panel-body>
            <p class="station-label">03 / 柯基的笔记角</p>
            <div class="station-panel-head">
              <h2>最近写下的</h2>
              <a class="text-link" href="/notes/">全部笔记</a>
            </div>
            <p class="station-copy">柯基把纸堆弄乱了，但重要的几页还在。</p>
            <div class="note-list">
              {notes.map((note) => (
                <a class="note-row-link" href={noteHref(note)}>
                  <time datetime={note.data.pubDate.toISOString()}>{formatDateDot(note.data.pubDate)}</time>
                  <span>{note.data.title}</span>
                  <small>{readingTime(note.body ?? '')} 分钟</small>
                </a>
              ))}
            </div>
            <div class="station-actions">
              <Portrait kind="corgi" class="station-mascot station-mascot-small" />
              <button class="poke-button" type="button" data-poke="corgi">逗一下柯基</button>
            </div>
          </div>
        </div>
      </section>

      <section class="room-station station-about" data-station="4">
        <div class="station-panel station-panel-about" data-station-panel>
          <button class="station-panel-toggle" type="button" data-panel-toggle aria-expanded="true" aria-controls="panel-about">
            <span class="station-panel-toggle-title">04 / 窗边</span>
            <span class="station-panel-toggle-action" data-toggle-action>展开内容</span>
          </button>
          <div class="station-panel-body" id="panel-about" data-panel-body>
            <p class="station-label">04 / 窗边</p>
            <h2>关于肥猫叉烧</h2>
            <p>
              我是肥猫叉烧。平时折腾工具、做小项目，偶尔打英雄联盟、读书、看电影、散步，然后把过程中的想法整理成文字。
              这个房间里的三只小动物分别负责项目、仓库和那些没整理好的想法。
            </p>
            <div class="mascot-line">
              <span><b>猫工程师</b> 负责项目和调试</span>
              <span><b>猪老板</b> 负责仓库和审阅</span>
              <span><b>柯基捣蛋鬼</b> 负责笔记和意外</span>
            </div>
            <div class="station-actions">
              <a class="button button-primary" href="/about/">关于这个站</a>
              <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">去 Gitee 看看</a>
            </div>
            <div class="poke-row">
              <button class="poke-button" type="button" data-poke="cat">摸摸猫</button>
              <button class="poke-button" type="button" data-poke="pig">拍拍猪</button>
              <button class="poke-button" type="button" data-poke="corgi">逗逗柯基</button>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const panelQuery = window.matchMedia('(max-width: 1280px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const panels = [...document.querySelectorAll<HTMLElement>('[data-station-panel]')];

  const syncPanelMode = () => {
    const mobile = panelQuery.matches && !reducedMotion;
    for (const panel of panels) {
      const toggle = panel.querySelector<HTMLButtonElement>('[data-panel-toggle]');
      const body = panel.querySelector<HTMLElement>('[data-panel-body]');
      const action = toggle?.querySelector<HTMLElement>('[data-toggle-action]');
      if (!toggle || !body) continue;
      if (mobile) {
        panel.classList.add('is-collapsed');
        panel.classList.remove('is-open');
        body.hidden = true;
        toggle.hidden = false;
        toggle.setAttribute('aria-expanded', 'false');
        if (action) action.textContent = '展开内容';
      } else {
        panel.classList.remove('is-collapsed', 'is-open');
        body.hidden = false;
        toggle.hidden = true;
        toggle.setAttribute('aria-expanded', 'true');
        if (action) action.textContent = '收起内容';
      }
    }
  };

  document.addEventListener('click', (event) => {
    const toggle = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-panel-toggle]') : null;
    if (!toggle) return;
    const panel = toggle.closest<HTMLElement>('[data-station-panel]');
    const body = panel?.querySelector<HTMLElement>('[data-panel-body]');
    const action = toggle.querySelector<HTMLElement>('[data-toggle-action]');
    if (!panel || !body) return;
    const open = body.hidden;
    body.hidden = !open;
    panel.classList.toggle('is-open', open);
    panel.classList.toggle('is-collapsed', !open);
    toggle.setAttribute('aria-expanded', String(open));
    if (action) action.textContent = open ? '收起内容' : '展开内容';
    window.dispatchEvent(new CustomEvent('cattery:panel-toggle', { detail: { open } }));
  });

  syncPanelMode();
  panelQuery.addEventListener('change', syncPanelMode);

  const room = document.querySelector<HTMLElement>('[data-room]');
  if (room && !reducedMotion) {
    const loadRoom = () => import('../scripts/room').then(({ initRoom }) => initRoom(room));
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(loadRoom, { timeout: 1200 });
    } else {
      setTimeout(loadRoom, 180);
    }
  }
</script>
