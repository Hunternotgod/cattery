---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMonthDayDot, getPublishedPosts, postHref, type Post } from '../utils/posts';

const posts = await getPublishedPosts();
const groups = new Map<string, Post[]>();

for (const post of posts) {
  const year = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
  }).format(post.data.pubDate);
  const list = groups.get(year) ?? [];
  list.push(post);
  groups.set(year, list);
}

const years = [...groups.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
---
<BaseLayout title="归档" description="按时间浏览 cattery 的全部文章。">
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">归档</h1>
      <p class="page-description">所有文章，按时间倒序排列。</p>
    </header>

    <section class="archive">
      {years.map(([year, yearPosts]) => (
        <div class="archive-year">
          <h2 class="archive-year-title">{year}</h2>
          <ul class="archive-list">
            {yearPosts.map((post) => (
              <li>
                <time datetime={post.data.pubDate.toISOString()}>{formatMonthDayDot(post.data.pubDate)}</time>
                <a href={postHref(post)}>{post.data.title}</a>
                <span class="archive-tags">{post.data.tags.join(' / ')}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>
