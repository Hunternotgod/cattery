---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMonthDayDot, getPublishedNotes, noteHref, type Note } from '../utils/notes';

const notes = await getPublishedNotes();
const groups = new Map<string, Note[]>();

for (const note of notes) {
  const year = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
  }).format(note.data.pubDate);
  const list = groups.get(year) ?? [];
  list.push(note);
  groups.set(year, list);
}

const years = [...groups.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
---
<BaseLayout title="归档" description="按时间浏览 cattery 的全部笔记。">
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">归档</h1>
      <p class="page-description">所有笔记，按时间倒序排列。</p>
    </header>

    <section class="archive">
      {years.map(([year, yearNotes]) => (
        <div class="archive-year">
          <h2 class="archive-year-title">{year}</h2>
          <ul class="archive-list">
            {yearNotes.map((note) => (
              <li>
                <time datetime={note.data.pubDate.toISOString()}>{formatMonthDayDot(note.data.pubDate)}</time>
                <a href={noteHref(note)}>{note.data.title}</a>
                <span class="archive-tags">{note.data.tags.join(' / ')}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>
