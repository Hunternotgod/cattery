---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mascot from '../../components/Mascot.astro';
import { SITE } from '../../data/site';
import {
  formatDateDot,
  getPublishedNotes,
  noteHref,
  readingTime,
  tagHref,
  type Note,
} from '../../utils/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      newer: notes[index - 1] ?? null,
      older: notes[index + 1] ?? null,
    },
  }));
}

interface Props {
  note: Note;
  newer: Note | null;
  older: Note | null;
}

const { note, newer, older } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(note.body ?? '');
const base = Astro.site ?? new URL('https://cattery.example.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: note.data.title,
  description: note.data.description,
  datePublished: note.data.pubDate.toISOString(),
  dateModified: (note.data.updatedDate ?? note.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  mainEntityOfPage: new URL(noteHref(note), base).toString(),
  image: new URL('/og-default.png', base).toString(),
};
---
<BaseLayout
  title={note.data.title}
  description={note.data.description}
  article
  publishedTime={note.data.pubDate.toISOString()}
  modifiedTime={(note.data.updatedDate ?? note.data.pubDate).toISOString()}
  jsonLd={jsonLd}
>
  <div class="container article-layout">
    <article data-pagefind-body>
      <header class="article-header">
        <div class="article-meta">
          <time datetime={note.data.pubDate.toISOString()}>{formatDateDot(note.data.pubDate)}</time>
          {note.data.updatedDate && <span>更新于 {formatDateDot(note.data.updatedDate)}</span>}
          <span>{minutes} 分钟阅读</span>
        </div>

        <h1 class="article-title" data-pagefind-meta="title">{note.data.title}</h1>
        <p class="article-description">{note.data.description}</p>

        {note.data.tags.length > 0 && (
          <div class="tag-row article-tags">
            {note.data.tags.map((tag) => (
              <a class="tag" href={tagHref(tag)}>{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="article-footer" data-pagefind-ignore>
        <a class="back-link" href="/notes/">返回笔记列表</a>
        <Mascot kind="corgi" class="article-corgi" />
        <a class="back-link" href="/archive/">查看归档</a>
      </footer>

      {(newer || older) && (
        <nav class="post-nav" aria-label="笔记导航" data-pagefind-ignore>
          {older ? (
            <a href={noteHref(older)}>
              <span>更早一篇</span>
              <strong>{older.data.title}</strong>
            </a>
          ) : (
            <div></div>
          )}
          {newer ? (
            <a href={noteHref(newer)}>
              <span>更新一篇</span>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <div></div>
          )}
        </nav>
      )}
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-label="笔记目录">
        <p class="toc-title">目录</p>
        <ul>
          {toc.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
