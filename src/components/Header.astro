---
import { SITE } from '../consts';
import CatMark from './CatMark.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <CatMark class="brand-mark" />
      <span class="brand-name">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {SITE.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-button" href="/search/" aria-label="搜索文章" title="搜索文章">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.8" />
          <path d="m15.5 15.5 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </a>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="切换深浅色模式" title="切换深浅色模式">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="3.8" stroke="currentColor" stroke-width="1.7" />
          <path d="M12 2.8v2M12 19.2v2M4.8 4.8 6.2 6.2M17.8 17.8l1.4 1.4M2.8 12h2M19.2 12h2M4.8 19.2l1.4-1.4M17.8 6.2l1.4-1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20 14.4A8.2 8.2 0 0 1 9.6 4a8.2 8.2 0 1 0 10.4 10.4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</header>
