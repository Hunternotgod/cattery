---
<div class="reading-progress" aria-hidden="true">
  <span class="reading-progress-fill" data-reading-progress-fill></span>
</div>

<script>
  const fill = document.querySelector<HTMLElement>('[data-reading-progress-fill]');
  const article = document.querySelector<HTMLElement>('main article');
  if (fill && article) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = article.getBoundingClientRect();
      const top = rect.top + window.scrollY;
      const bottom = rect.bottom + window.scrollY;
      const readingLine = window.scrollY + window.innerHeight;
      const span = Math.max(1, bottom - top);
      const progress = Math.min(1, Math.max(0, (readingLine - top) / span));
      fill.style.transform = `scaleX(${progress})`;
      fill.parentElement?.classList.toggle('is-complete', progress > 0.995);
    };
    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  }
</script>
