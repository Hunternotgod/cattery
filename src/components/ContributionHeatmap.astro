---
import { GITEE_CONTRIBUTIONS, type ContributionDay } from '../data/contributions';
import { SITE } from '../data/site';
import { formatRepoDate } from '../data/repos';

interface Props {
  variant?: 'compact' | 'full' | 'about';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const snapshot = GITEE_CONTRIBUTIONS;
const recentWeeks = variant === 'compact' ? 20 : 53;
const byDate = new Map(snapshot.days.map((day) => [day.date, day]));
const firstDate = snapshot.days[0]?.date ? new Date(`${snapshot.days[0].date}T00:00:00Z`) : new Date();
const lastDate = snapshot.days.at(-1)?.date ? new Date(`${snapshot.days.at(-1)!.date}T00:00:00Z`) : firstDate;
const dayMs = 24 * 60 * 60 * 1000;
const weekday = (date: Date) => (date.getUTCDay() + 6) % 7;
const monday = new Date(firstDate.getTime() - weekday(firstDate) * dayMs);
const totalDays = Math.max(1, Math.floor((lastDate.getTime() - monday.getTime()) / dayMs) + 1);
const paddedDays: ContributionDay[] = Array.from({ length: Math.ceil(totalDays / 7) * 7 }, (_, index) => {
  const date = new Date(monday.getTime() + index * dayMs);
  const iso = date.toISOString().slice(0, 10);
  return byDate.get(iso) ?? { date: iso, count: 0, level: 0 };
});
const allWeeks = Array.from({ length: Math.ceil(paddedDays.length / 7) }, (_, index) =>
  paddedDays.slice(index * 7, index * 7 + 7),
).slice(-recentWeeks);
const monthFormatter = new Intl.DateTimeFormat('zh-CN', { month: 'short', timeZone: 'UTC' });
const monthLabels = allWeeks.map((week, index) => {
  const first = new Date(`${week[0].date}T00:00:00Z`);
  const previous = index > 0 ? new Date(`${allWeeks[index - 1][0].date}T00:00:00Z`) : null;
  return previous && previous.getUTCMonth() === first.getUTCMonth() ? '' : monthFormatter.format(first);
});
const weekdayLabels = ['一', '', '三', '', '五', '', '日'];
const title = variant === 'compact' ? '最近贡献' : 'Gitee 贡献热力图';
const synced = snapshot.syncedAt ? formatRepoDate(snapshot.syncedAt) : null;
const flatDays = allWeeks.flat();
const firstActive = Math.max(0, flatDays.findIndex((day) => day.count > 0));
---
<section class:list={['contribution-heatmap', `is-${variant}`, className]} data-contribution-heatmap aria-labelledby={`contributions-${variant}`}>
  <header class="contribution-head">
    <div>
      <p class="section-kicker">gitee activity</p>
      <h2 id={`contributions-${variant}`}>{title}</h2>
    </div>
    {variant !== 'compact' && (
      <a class="text-link" href={SITE.giteeUrl} target="_blank" rel="noopener noreferrer">Gitee 主页</a>
    )}
  </header>

  {variant === 'about' && (
    <dl class="contribution-stats">
      <div><dt>近一年贡献</dt><dd>{snapshot.total}</dd></div>
      <div><dt>活跃天数</dt><dd>{snapshot.activeDays}</dd></div>
      <div><dt>最长连续</dt><dd>{snapshot.longestStreak} 天</dd></div>
    </dl>
  )}

  <div class="contribution-chart" style={`--contribution-weeks: ${allWeeks.length}`}>
    <div class="contribution-months" aria-hidden="true">
      {monthLabels.map((label) => <span>{label}</span>)}
    </div>
    <div class="contribution-chart-body">
      <div class="contribution-weekdays" aria-hidden="true">
        {weekdayLabels.map((label) => <span>{label}</span>)}
      </div>
      <div
        class="contribution-grid"
        role="grid"
        aria-label={`${title}，${snapshot.total} 次贡献，${snapshot.activeDays} 个活跃日`}
        tabindex="0"
        data-contribution-grid
        data-first-index={firstActive}
      >
        {allWeeks.map((week, weekIndex) => (
          <div class="contribution-week" role="row">
            {week.map((day, rowIndex) => {
              const index = weekIndex * 7 + rowIndex;
              const label = `${day.date}，${day.count} 次贡献`;
              return (
                <button
                  class:list={['contribution-cell', `level-${day.level}`]}
                  type="button"
                  role="gridcell"
                  tabindex="-1"
                  data-index={index}
                  data-tooltip={label}
                  aria-label={label}
                  title={label}
                ></button>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  </div>

  <footer class="contribution-foot">
    <div class="contribution-legend" aria-label="贡献等级：从少到多">
      <span>少</span>
      {[0, 1, 2, 3, 4].map((level) => <i class={`level-${level}`}></i>)}
      <span>多</span>
    </div>
    {synced && <span>数据更新于 {synced}</span>}
  </footer>
</section>

<script>
  for (const heatmap of document.querySelectorAll<HTMLElement>('[data-contribution-heatmap]')) {
    const grid = heatmap.querySelector<HTMLElement>('[data-contribution-grid]');
    if (!grid) continue;
    const cells = [...grid.querySelectorAll<HTMLButtonElement>('.contribution-cell')];
    let focused = Number(grid.dataset.firstIndex ?? 0);

    const focusCell = (index: number) => {
      if (cells.length === 0) return;
      focused = Math.max(0, Math.min(cells.length - 1, index));
      cells[focused]?.focus({ preventScroll: true });
    };

    grid.addEventListener('focus', () => focusCell(focused));
    grid.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') focusCell(focused - 7);
      else if (event.key === 'ArrowRight') focusCell(focused + 7);
      else if (event.key === 'ArrowUp') focusCell(focused - 1);
      else if (event.key === 'ArrowDown') focusCell(focused + 1);
      else if (event.key === 'Home') focusCell(0);
      else if (event.key === 'End') focusCell(cells.length - 1);
      else return;
      event.preventDefault();
    });
    cells.forEach((cell, index) => {
      cell.addEventListener('focus', () => { focused = index; });
    });
  }
</script>
