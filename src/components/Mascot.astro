    <rect x="48" y="118" width="64" height="52" rx="26" fill="#f3a7b9" stroke="#191714" stroke-width="5" />
    <circle cx="58" cy="86" r="5" fill="#191714" />
    <circle cx="102" cy="86" r="5" fill="#191714" />
    <circle cx="60" cy="84" r="1.8" fill="#f2ebdd" />
    <circle cx="104" cy="84" r="1.8" fill="#f2ebdd" />
    <rect x="56" y="99" width="48" height="28" rx="14" fill="#e98ba0" stroke="#191714" stroke-width="4" />
    <circle cx="70" cy="113" r="3" fill="#191714" />
    <circle cx="90" cy="113" r="3" fill="#191714" />
    <path d="M80 49v18" stroke="#d9472b" stroke-width="7" />
