    <path d="M80 103c0 5-4 8-8 8M80 103c0 5 4 8 8 8" stroke="#191714" stroke-width="2.3" stroke-linecap="round" />
    <path d="M74 112h12v7H74z" fill="#ef7890" stroke="#191714" stroke-width="2" />
    <path d="M49 142c0-9 5-14 12-14s12 5 12 14v18H49v-18ZM87 142c0-9 5-14 12-14s12 5 12 14v18H87v-18Z" fill="#f7e8d4" stroke="#191714" stroke-width="3" />
    <path d="M128 128c14 5 18 17 8 26" stroke="#e8792b" stroke-width="8" stroke-linecap="round" />
